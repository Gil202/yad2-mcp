{
  "name": "yad2-mcp",
  "version": "1.0.0",
  "description": "Yad2 Real Estate Scraper and Cloudflare Worker MCP Server",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/worker.test.cjs",
    "d1:migrate:local": "wrangler d1 migrations apply yad2-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply yad2-db --remote",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init:local": "wrangler d1 execute yad2-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute yad2-db --remote --file=./schema.sql",
    "scrape:dev": "npm --prefix scraper run scrape"
  },
  "keywords": [
    "yad2",
    "mcp",
    "cloudflare-worker",
    "scraper",
    "ai-agent",
    "open-source"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
